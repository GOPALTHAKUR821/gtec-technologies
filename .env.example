# PostgreSQL connection string from Neon or another PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Public URL used to create QR verification links.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Set privately for the one-time account seed command. Initial passwords are replaced at first sign in.
INITIAL_MASTER_PASSWORD=
INITIAL_MD_PASSWORD=
INITIAL_MANAGER_PASSWORD=
INITIAL_SUPERVISOR_PASSWORD=

# Required only after secure private file storage is configured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CONTRACTOR_STORAGE_BUCKET=contractor-private
